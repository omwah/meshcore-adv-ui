# Main menu and the pages under it (each reached from a fresh menu).
key menu
shot menu
# Backspace goes back as Esc does, outside text.
key bksp
shot menu-bksp-home
key menu
key down 5
shot menu-radio-sel
key enter
shot radio
key right
shot radio-preset-next
hold esc 900
key menu
key down 6
key enter
shot diag-radio
key right
shot diag-system
hold esc 900
key menu
key down 7
key enter
shot packet-log
hold esc 900
gps on
key menu
key down 8
key enter
shot gps
hold esc 900
key menu
key down
key enter
shot heard
hold esc 900
key menu
key down 2
key enter
wait 3500
shot discover
