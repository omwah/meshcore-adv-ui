# Contact details and actions.
key right
key tab
shot contact-detail
# Details, Favourite, Share battery (per contact in the mock), Reset path, Trace route
key down 5
key enter
wait 1600
shot contact-trace
key esc
# Ping, Show in Chats, Clear history
key down 3
key enter
shot contact-remove-confirm
key esc
key up 8
key down 3
shot contact-telemetry
